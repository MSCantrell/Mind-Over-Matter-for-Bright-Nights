msgstr ""

#. ~ Description for the sound of spell '{'str': 'mom_pyrolytic_trap_noise',
#. '//~': 'NO_I18N'}'
#: ./fork_powers.json
msgid "a deep, roaring whoomph!"
msgstr ""

