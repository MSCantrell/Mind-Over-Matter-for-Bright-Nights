#: ./professions.json
msgctxt "profession_male"
msgid "Doomseer"
msgstr ""

#: ./professions.json
msgctxt "profession_female"
msgid "Doomseer"
msgstr ""

#. ~ Profession (male Doomseer) description
#: ./professions.json
msgctxt "prof_desc_male"
msgid ""
"You knew the world was going to end, but they never listened.  They never "
"listened!  They couldn't see the things that walked among them!  They didn't"
