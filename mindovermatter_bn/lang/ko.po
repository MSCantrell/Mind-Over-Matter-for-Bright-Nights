msgstr "수학자 A57은 갑옷을 뚫지 않고 %2$s(을)를 공격했습니다."

#. ~ MONSTER 'mon_transcendant_alpha_psion':
#. extend.special_attacks.no_dmg_msg_npc
#: monsters/bosses.json
msgid "Mathematician A57 hits <npcname>'s %2$s without penetrating their armor."
msgstr "수학자 A57은 <npcname>의 %2$s(을)를 갑옷을 뚫지 않고 공격합니다."

#. ~ MONSTER 'mon_transcendant_alpha_psion':
#. extend.special_attacks.monster_message
#: monsters/bosses.json
msgid "Mathematician A57's skin takes on a slightly waxen appearance."
msgstr "수학자 A57의 피부는 약간 밀랍처럼 보입니다."

#. ~ MONSTER 'mon_transcendant_alpha_psion':
#. extend.special_attacks.monster_message
#: monsters/bosses.json
msgid "Mathematician A57 begins moving much more quickly."
msgstr "수학자 A57은 훨씬 더 빨리 움직이기 시작합니다."

#. ~ MONSTER 'mon_transcendant_alpha_psion': extend.special_attacks.miss_msg_u
#. ~ MONSTER 'mon_transcendant_alpha_psion':
#. extend.special_attacks.miss_msg_npc
#. ~ MONSTER 'mon_transcendant_alpha_psion': extend.special_attacks.hit_dmg_u
#. ~ MONSTER 'mon_transcendant_alpha_psion':
#. extend.special_attacks.hit_dmg_npc
#. ~ MONSTER 'mon_transcendant_alpha_psion':
#. extend.special_attacks.no_dmg_msg_u
#. ~ MONSTER 'mon_transcendant_alpha_psion':
#. extend.special_attacks.no_dmg_msg_npc
#: monsters/bosses.json
msgid "Mathematician A57 blurs as they explode into motion!"
msgstr "수학자 A57이 폭발적으로 움직이면서 흐릿해집니다!"

#. ~ MONSTER 'mon_transcendant_alpha_psion':
#. extend.special_attacks.monster_message
#: monsters/bosses.json
msgid "Mathematician A57 stares at %3$s and drags %3$s toward them!"
msgstr "수학자 A57(이)가 %3$s(을)를 응시하며 %3$s(을)를 자신 쪽으로 끌어당깁니다!"

#. ~ MONSTER 'mon_transcendant_alpha_psion':
#. extend.special_attacks.monster_message
#: monsters/bosses.json
msgid "The air around Mathematician A57Mathematician A57 wavers."
msgstr "수학자 A57 주변의 공기가 흔들립니다."

#. ~ MONSTER 'mon_transcendant_alpha_psion':
#. extend.special_attacks.monster_message
#: monsters/bosses.json
msgid "The air around Mathematician A57 distorts."
msgstr "수학자 A57 주변의 공기가 왜곡됩니다."

#. ~ MONSTER 'mon_transcendant_alpha_psion': extend.special_attacks.miss_msg_u
#: monsters/bosses.json
msgid "Mathematician A57 tries to touch you, but you dodge!"
msgstr "수학자 A57이 당신을 만지려 했지만 피했습니다!"

#. ~ MONSTER 'mon_transcendant_alpha_psion':
#. extend.special_attacks.miss_msg_npc
#: monsters/bosses.json
