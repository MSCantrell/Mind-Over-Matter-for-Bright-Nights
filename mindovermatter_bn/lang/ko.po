#. ~ Description for {'str': '[Ψ]telekinetic jack'}
#: items/psions_summon_items.json
msgid "Using your powers, you can lift up a vehicle just enough to allow you to change the wheels."
msgstr "능력을 사용하면 바퀴를 교체할 수 있을 만큼 차량을 들어올릴 수 있습니다."

#: items/psions_summon_items.json
msgid "[Ψ]Vitakinetic Wound Staunching"
msgid_plural "[Ψ]Vitakinetic Wound Staunchings"
