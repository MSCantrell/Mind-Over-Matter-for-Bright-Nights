#. ~ MONSTER 'mon_feral_human_porter3': extend.special_attacks.hit_dmg_u
#.
#: monsters/feral_psychics.json monsters/monster_special_attacks.json
msgid "%1$s touches you and the world warps around you!"
msgstr "%1$s(이)가 당신을 만지자 주변의 세상이 뒤틀립니다!"

#. ~ MONSTER 'mon_feral_human_porter3': extend.special_attacks.hit_dmg_npc
#.
#: monsters/feral_psychics.json monsters/monster_special_attacks.json
