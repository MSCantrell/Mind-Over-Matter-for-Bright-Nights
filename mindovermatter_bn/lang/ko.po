#. ~ Description for {'str': '[Ψ]Flamethrower Hellhound', '//~': 'NO_I18N'}
#: magic/monsters_spells.json
msgid "Spray fire in a cone in front of you, if you're a hellhound."
msgstr "당신이 지옥의 사냥개라면, 당신 앞에 원뿔 모양으로 불을 뿜으세요."

#. ~ Description for the sound of spell '{'str': '[Ψ]Mindhammer Monster',
#. '//~': 'NO_I18N'}'
#: magic/monsters_spells.json
msgid "a thud"
msgstr "쿵"

#. ~ Description for the sound of spell '{'str': 'Wrecking Ball Monster',
#. '//~': 'NO_I18N'}'
#. ~ Description for the sound of spell '[Ψ]Wrecking Ball'
#: magic/monsters_spells.json spells/telekinesis.json
