#. ~ MONSTER 'mon_feral_human_porter3': extend.special_attacks.monster_message
#: monsters/feral_psychics.json
msgid "The air wavers around %1$s as they reach for %3$s."
msgstr "%1$s(이)가 %3$s에게 손을 뻗자 주변 공기가 일렁입니다."

#. ~ MONSTER 'mon_feral_human_porter3': extend.special_attacks.monster_message
#: monsters/feral_psychics.json
msgid "The lights around %1$s waver and shapes appear near %3$s."
msgstr "%1$s 주변의 불빛이 흔들리고, %3$s 근처에 모양이 나타납니다."

#. ~ MONSTER 'mon_feral_human_porter3': extend.special_attacks.monster_message
#: monsters/feral_psychics.json
