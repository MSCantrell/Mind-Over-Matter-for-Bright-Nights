#. ~ Scenario start_name for 'challenge_scen_firestarter'
#: scenarios.json
msgctxt "start_name"
msgid "Away from civilization"
msgstr "문명으로부터의 도피"

#: skills.json
msgid "metaphysics"
msgstr "형이상학"

#. ~ Description for {'str': 'metaphysics'}
#: skills.json
msgid "Your ability to manipulate forces of energy often considered supernatural."
msgstr "에너지를 조작하는 초자연현상을 다루는 능력입니다."

#: traps.json
msgid "Dead Fifth Sun Achievement Trap"
msgstr "죽은 다섯 번째 태양 업적 함정"

#: effects/effects_psionic.json
msgid "Personal Enhancement"
msgstr "신체 강화"

#. ~ desc of effect 'effect_biokin_physical'
#: effects/effects_psionic.json
msgid "Psionic energy floods your body, raising all four of your attributes."
msgstr "초능력 에너지가 온몸에 흘러들어 네 가지 능력치가 증가합니다."

#. ~ Remove message for effect(s) 'Personal Enhancement'.
#: effects/effects_psionic.json
msgid "The surge of power fades away."
msgstr "힘의 급류가 사라집니다."

#: effects/effects_psionic.json
msgid "Nether-Attunement"
msgstr "네더 조율"

#. ~ desc of effect 'effect_disease_psionic_drain'
#: effects/effects_psionic.json
msgid ""
"You feel a little odd and your control over your powers isn't as sure as it was.  There might be "
"unexpected results of you channeling psionics now."
msgstr ""
"조금 이상한 기분이 들고, 능력 제어도 예전만큼 확실하지 않습니다. 지금 초능력을 활용하면 예상치 못한 "
"결과가 나올지도 모릅니다."

#. ~ Apply message for effect(s) 'Nether-Attunement'.
#: effects/effects_psionic.json
msgid ""
"You feel a little odd, like you've just awoken from a dream.  All that psionic channeling might have "
"unexpected effects."
msgstr ""
"마치 꿈에서 막 깨어난 것처럼 기분이 좀 이상합니다. 초능력 채널링이 예상치 못한 효과를 가져올지도 모릅"
"니다."

#. ~ Remove message for effect(s) 'Nether-Attunement'.
#: effects/effects_psionic.json
msgid ""
"You take a deep breath as the strange feelings fade.  You are in full control of your powers once "
"again."
msgstr ""
"이상한 감정이 사라지는 것을 느끼며 심호흡을 합니다. 다시 한번 당신의 능력을 완벽하게 제어할 수 있게 "
"되었습니다."

#. ~ Decay message for effect(s) 'Nether-Attunement'.
#: effects/effects_psionic.json
msgid "The constant hum of power fades, just a little.  It's easier to think now."
msgstr "끊임없이 들려오던 힘의 웅웅거림이 아주 약간 잦아들었습니다. 이제 생각하기가 더 수월해집니다."

#. ~ Decay message for effect(s) 'Nether-Attunement'.
#: effects/effects_psionic.json
msgid "The roar of the Nether subsides.  You can finally hear your own thoughts again."
msgstr "네더의 포효가 가라앉았습니다. 마침내 당신의 생각을 다시 들을 수 있게 되었습니다."

#: effects/effects_psionic.json
msgid "Clairvoyance"
msgstr "천리안"

#. ~ desc of effect 'effect_clair_voyance'
#: effects/effects_psionic.json
msgid "Your inner eye is open; you see through nearby walls."
msgstr "내면의 눈이 열려 가까운 벽 너머를 볼 수 있게 되었습니다."

#. ~ Apply message for effect(s) 'Clairvoyance'.
#. ~ Message for SPELL '[Ψ]Clairvoyance'
#: effects/effects_psionic.json spells/clairsentience.json
msgid "You open your inner eye."
msgstr "내면의 눈을 떴습니다."

#. ~ Remove message for effect(s) 'Clairvoyance'.
#: effects/effects_psionic.json
msgid "Your inner eye closes."
msgstr "내면의 눈이 감깁니다."

#: effects/effects_psionic.json effects/gen_effects.json
msgid "Burning Air"
msgstr "불타는 공기"

#. ~ desc of effect 'effect_pyrokinetic_aura_damage'
#: effects/effects_psionic.json
msgid "The air is intolerably hot."
msgstr "공기가 참을 수 없을 정도로 더워요."

#. ~ Remove message for effect(s) 'Burning Air'.
#: effects/effects_psionic.json
msgid "The air cools down."
msgstr "공기가 식는다."

#: effects/gen_effects.json
msgid "illuminated"
msgstr "광휘"

#. ~ desc of effect 'LIXA_illuminated'
#: effects/gen_effects.json
msgid "You're covered in congealed light!"
msgstr "응고된 빛으로 뒤덮였습니다!"

#. ~ Apply message for effect(s) 'illuminated'.
#: effects/gen_effects.json
msgid "The sticky globs of light cover you, and begin to burn!"
msgstr "끈적이는 빛 덩어리가 당신을 뒤덮은 후 불타오르기 시작합니다!"

#: effects/gen_effects.json
msgid "Asked to heal"
msgstr "치유 요청 받음"

