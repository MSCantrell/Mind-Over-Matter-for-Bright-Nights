msgid_plural "copies of Lab Report: PATIENT MOSAIC process"
msgstr[0] "отчёт: процедура «ТЕРПЕЛИВАЯ МОЗАИКА»"
msgstr[1] "отчёта: процедура «ТЕРПЕЛИВАЯ МОЗАИКА»"
msgstr[2] "отчётов: процедура «ТЕРПЕЛИВАЯ МОЗАИКА»"

#. ~ Description for {'str': 'Lab Report: PATIENT MOSAIC process', 'str_pl':
