msgid ""
"%1$s stares at <npcname>, but the telekinetic attack rebounds off their "
"armor."
msgstr ""
"%1$s пристально смотрит на цель (<npcname>), но телекинетическая атака "
"отскакивает от её брони."

#. ~ MONSTER 'mon_feral_scientist_psychic':
#. extend.special_attacks.monster_message
