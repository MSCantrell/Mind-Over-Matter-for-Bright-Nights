msgstr[1] "деревянных стула"
msgstr[2] "деревянных стульев"

#. ~ Description for {'str': 'wooden chair'}
#: items/mom_item_bridges.json
msgid "A simple wooden chair, with four legs, a seat, and a back."
msgstr "Простой деревянный стул с четырьмя ножками, сиденьем и спинкой."

#: items/mom_item_bridges.json
msgid "human skull"
