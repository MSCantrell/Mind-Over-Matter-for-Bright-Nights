msgstr "%1$s пристально смотрит на вас и наносит псионический удар в %2$s!"

#. ~ MONSTER 'mon_feral_scientist_psychic': extend.special_attacks.hit_dmg_npc
#. ~ MONSTER 'mon_feral_human_telekin2': extend.special_attacks.hit_dmg_npc
