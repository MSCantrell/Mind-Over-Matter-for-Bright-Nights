msgstr "Ваша защита от чрезмерно сильной связи с Запредельем исчезает."

#: effects/gen_effects.json
msgid "Noetically Fragile"
msgstr "Ноэтическая хрупкость"

#. ~ desc of effect 'effect_noetic_resilience_comedown'
#: effects/gen_effects.json
msgid ""
"Your psionic capacity, and physical stamina, are reduced by the aftereffects"
