msgid ""
"%1$s stares at you, but the telekinetic attack rebounds off your armor."
msgstr ""
"%1$s пристально смотрит на вас, но телекинетическая атака отскакивает от "
"вашей брони."

#. ~ MONSTER 'mon_feral_scientist_psychic':
#. extend.special_attacks.no_dmg_msg_npc
#. ~ MONSTER 'mon_feral_human_telekin2': extend.special_attacks.no_dmg_msg_npc
