msgstr "Вокруг вас возникает резкое свечение!"

#. ~ Remove message for effect(s) 'Illuminated'.
#: effects/gen_effects.json
msgid "The harsh glow around you fades away."
msgstr "Резкое свечение вокруг вас угасает."

#: effects/gen_effects.json
msgid "Radio Transception"
msgstr "Радиопередача"

#. ~ desc of effect 'effect_photokinetic_radio'
#: effects/gen_effects.json
